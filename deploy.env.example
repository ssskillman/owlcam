# Settings for the workstation that deploys the site. Copy to deploy.env,
# which is gitignored:
#
#   cp deploy.env.example deploy.env
#
# The Makefile reads deploy.env, so `make pi-deploy` picks these up in any
# shell. This is not the Pi's /etc/owlcam/owlcam.env template — that is
# .env.example. Keep secrets out of both; see docs/security.md.

# Origin the browser uses to reach the animal identifier API, baked into
# /identify at build time. `make pi-deploy` refuses to run when this is unset,
# because a page built with an empty origin reports the photo-processing
# server as offline while the build and the deploy both look fine.
#
# Whichever machine runs uvicorn publishes 127.0.0.1:8767. Same origin either
# way; the verb decides who can reach it:
#
#   tailscale serve --bg --https=8443 http://127.0.0.1:8767    # tailnet only
#   tailscale funnel --bg --yes --https=8443 http://127.0.0.1:8767  # public
#
# Always 8443, never 443: 443 is the Pi's public site. Use that machine's
# MagicDNS name with no trailing slash. The same value goes in
# OWLCAM_ANIMAL_ID_ORIGIN in ~/.config/owlcam/site.env on the Pi so its CSP
# allows connect-src / img-src.
ANIMAL_ID_API_ORIGIN=https://your-machine.tailnet-name.ts.net:8443
