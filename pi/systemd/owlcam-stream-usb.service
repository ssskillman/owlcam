[Unit]
Description=OwlCam USB camera published to MediaMTX over RTSP (/owl2)
Documentation=https://github.com/ssskillman/owlcam/blob/main/docs/live-feed.md
After=owlcam-mediamtx.service
Wants=owlcam-mediamtx.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/owlcam-start-stream-usb
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
