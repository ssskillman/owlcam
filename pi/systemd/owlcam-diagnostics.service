[Unit]
Description=Read-only OwlCam diagnostics endpoint
Documentation=https://github.com/ssskillman/owlcam/blob/main/docs/live-feed.md
After=network-online.target owlcam-mediamtx.service owlcam-stream.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/owlcam-diagnostics
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=5

# Loopback plus /proc, SoC thermal, and nest BME280 via i2ctransfer.
# PrivateDevices hides /dev/i2c-1 from user units even with DeviceAllow.
NoNewPrivileges=true
PrivateDevices=false
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_INET

[Install]
WantedBy=default.target
