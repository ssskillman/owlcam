# Primary admin (written by owlcam-configure-admin)
OWLCAM_ADMIN_USERNAME=admin
OWLCAM_ADMIN_PASSWORD_HASH=scrypt:16384:8:1:REPLACE:REPLACE

# Extra admins: one username:hash per line in ~/.config/owlcam/admin-users
# (use owlcam-admin-add-user on the Pi)

# Nest capture deletion proxies to the inference host (same secret on PC).
OWLCAM_IDENTIFY_URL=https://YOUR-INFERENCE-HOST.tail31318f.ts.net:8443/api/animal-identification
OWLCAM_VISIT_ADMIN_SECRET=generate-a-long-random-secret
