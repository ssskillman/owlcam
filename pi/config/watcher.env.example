# Copy to ~/.config/owlcam/watcher.env on the Pi (never commit secrets).
OWLCAM_RTSP_URL=rtsp://127.0.0.1:8554/owl
OWLCAM_IDENTIFY_URL=https://YOUR-INFERENCE-HOST.tail31318f.ts.net:8443/api/animal-identification
OWLCAM_OUTBOX=/home/shawn/owlcam/outbox
OWLCAM_SENT=/home/shawn/owlcam/sent
OWLCAM_FAILED=/home/shawn/owlcam/failed
OWLCAM_CAPTURE_INTERVAL_SECONDS=30
OWLCAM_QUEUE_RETRY_SECONDS=60
OWLCAM_POST_TIMEOUT_SECONDS=90
OWLCAM_MAX_OUTBOX_FILES=500
