# Copy to ~/.config/owlcam/ir.env (mode 600). Used by owlcam-ir.service.

# off | manual_on | auto
OWLCAM_IR_MODE=auto

OWLCAM_IR_GPIO=23
OWLCAM_IR_PORT=8767

# Auto pulse length after motion (seconds)
OWLCAM_IR_AUTO_TIMEOUT_SECONDS=20
OWLCAM_IR_MAX_CONTINUOUS_ON_SECONDS=60
OWLCAM_IR_COOLDOWN_SECONDS=10

# Raleigh-ish defaults; adjust if the nest box moves
OWLCAM_IR_LATITUDE=35.7796
OWLCAM_IR_LONGITUDE=-78.6382
OWLCAM_IR_TIMEZONE=America/New_York
OWLCAM_IR_DARK_OFFSET_AFTER_SUNSET_MIN=0
OWLCAM_IR_DARK_OFFSET_BEFORE_SUNRISE_MIN=0

# Bench test during daylight (cover the IR board photoresistor too)
# OWLCAM_IR_SIMULATE_DARK=1

OWLCAM_RTSP_URL=rtsp://127.0.0.1:8554/owl
OWLCAM_IR_MOTION_INTERVAL_SECONDS=2
OWLCAM_IR_MOTION_THRESHOLD=8.0
