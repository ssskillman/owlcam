# Copy to ~/.config/owlcam/alerts.env on the inference PC (never commit).
# Load before starting uvicorn, or set in the Windows scheduled task environment.
ANIMAL_ID_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ANIMAL_ID_ALERT_SPECIES=barred owl,raccoon
ANIMAL_ID_ALERT_COOLDOWN_SECONDS=1800
